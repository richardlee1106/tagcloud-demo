{
  "name": "vite-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev:V3": "node scripts/cleanup-v3-dev.js",
    "guard:no-rules-line-imports": "node scripts/check-no-rules-line-imports.mjs",
    "dev:frontend": "vite",
    "dev:frontend:v3": "vite --mode v3",
    "dev:frontend:v4": "vite --mode v4",
    "dev:backend": "cd V1-fastify-backend && npm run dev",
    "dev:all": "npx concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:stack": "npx concurrently -n front,back -c cyan,green \"npm run dev:frontend\" \"cd V1-fastify-backend && npm run dev:stack\"",
    "dev:V3": "npx concurrently -n front,v3 -c cyan,magenta \"npm run dev:frontend:v3\" \"cd V3-GeoEncoder-RAG && npm run dev\"",
    "dev:v4": "node scripts/dev-v4.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run guard:no-rules-line-imports && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.2.5",
    "@deck.gl/core": "^9.2.5",
    "@deck.gl/layers": "^9.2.5",
    "@deck.gl/mesh-layers": "^9.2.5",
    "@luma.gl/core": "^9.2.5",
    "@luma.gl/webgl": "^9.2.5",
    "@turf/boolean-point-in-polygon": "^7.3.1",
    "@turf/centroid": "^7.3.1",
    "@turf/helpers": "^7.3.1",
    "@types/d3": "^7.4.3",
    "axios": "^1.13.2",
    "d3": "^7.9.0",
    "d3-cloud": "^1.2.7",
    "dotenv": "^16.6.1",
    "element-plus": "^2.13.1",
    "geotiff": "^2.1.4-beta.1",
    "html2canvas": "^1.4.1",
    "marked": "^17.0.1",
    "ol": "^10.7.0",
    "rbush": "^4.0.1",
    "sass": "^1.97.2",
    "three": "^0.182.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^8.0.0-beta.15",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "engineStrict": false
}
