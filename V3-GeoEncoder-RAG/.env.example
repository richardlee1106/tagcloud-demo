# V3 GeoEncoder RAG 环境配置

# 服务端口
PORT=3300

# 数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DATABASE=geoloom

# LLM 服务配置
# 方案1: LM Studio (HTTP)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3.5-2b
LLM_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# 方案2: Ollama (本地，若已切到 llama.cpp 可保持 false)
# USE_OLLAMA=false
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3-4b-instruct-2507-q8
# OLLAMA_SMALL_MODEL=qwen3-4b-instruct-2507-q8
# OLLAMA_REASONING_MODEL=qwen3.5-9b-claude-4.6-opus-reasoning-distilled-v2
# PLANNER_MODEL=qwen3.5-9b-claude-4.6-opus-reasoning-distilled-v2
# PLANNER_BASE_URL=http://127.0.0.1:18081/v1
# OLLAMA_EMBEDDING_MODEL=bge-base-zh-v1.5
# ANSWER_SYNTHESIS_MODEL=qwen3-4b-instruct-2507-q8
# ANSWER_SYNTHESIS_BASE_URL=http://127.0.0.1:18082/v1
# INTENT_USE_OLLAMA=false
# SMALL_LLM_MODEL=qwen3-4b-instruct-2507-q8
# INTENT_REASONING_MODEL=qwen3-4b-instruct-2507-q8

# 方案3: llama.cpp（本地 server）
# LLAMACPP_AUTOSTART=true
# LLAMACPP_SERVER_PATH=C:/path/to/llama-server.exe
# LLAMACPP_STARTUP_TIMEOUT_MS=180000
# PLANNER_MODEL=qwen3.5-9b-claude-4.6-opus-reasoning-distilled-v2
# PLANNER_BASE_URL=http://127.0.0.1:18081/v1
# PLANNER_MODEL_PATH=D:/models/path/to/planner.gguf
# PLANNER_CTX_SIZE=4096
# PLANNER_GPU_LAYERS=999
# PLANNER_REASONING=off
# PLANNER_PARALLEL=1
# ANSWER_SYNTHESIS_MODEL=qwen3-4b-instruct-2507-q8
# ANSWER_SYNTHESIS_BASE_URL=http://127.0.0.1:18082/v1
# ANSWER_SYNTHESIS_MODEL_PATH=D:/models/path/to/synthesis.gguf
# ANSWER_SYNTHESIS_CTX_SIZE=4096
# ANSWER_SYNTHESIS_GPU_LAYERS=0
# ANSWER_SYNTHESIS_REASONING=off
# ANSWER_SYNTHESIS_PARALLEL=1

# Python gRPC 服务
SPATIAL_GRPC_ENABLED=true
SPATIAL_GRPC_ENDPOINT=127.0.0.1:50051

# Planner Line 聊天分流开关
PLANNER_CHAT_ENABLED=true
PLANNER_CHAT_TASK_TYPES=nearby_lookup,area_overview,support_gap_analysis,site_suitability,region_comparison
# PLANNER_EVAL_TIMEOUT_MS=360000
