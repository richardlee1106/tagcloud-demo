# =====================================================
# Fastify Backend 环境变量模板
# 用法：复制为 `.env` 后按实际环境填写。
# =====================================================

# ---------------------
# 服务监听
# ---------------------
PORT=3200
HOST=0.0.0.0

# ---------------------
# PostgreSQL + PostGIS
# ---------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DATABASE=geoloom

# ---------------------
# 可选向量服务（如旧链路仍在使用）
# ---------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=poi_embeddings

# ---------------------
# LLM 配置
# ---------------------
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3.5-4b
LLM_EMBEDDING_MODEL=text-embedding-bge-base-zh-v1.5
GLM_API_KEY=

# ---------------------
# Jobs / Queue
# ---------------------
# Redis 可用时启用 BullMQ；不可用则自动降级为内存队列。
REDIS_URL=redis://localhost:6379
SPATIAL_QUEUE_NAME=spatial-narrative
SPATIAL_WORKER_CONCURRENCY=1

# true: API 进程内联启动 worker（开发方便）
# false: 独立 worker 进程/容器（生产推荐）
ENABLE_INLINE_SPATIAL_WORKER=true

# ---------------------
# Python gRPC 计算服务
# ---------------------
SPATIAL_GRPC_ENABLED=true
SPATIAL_GRPC_ENDPOINT=127.0.0.1:50051
SPATIAL_GRPC_TIMEOUT_MS=25000
SPATIAL_GRPC_WORKERS=4  # gRPC工作线程数，需与数据库连接池配置协调

# ---------------------
# 计算开关（MVP）
# ---------------------
ENABLE_CLUSTERING=true
ENABLE_FUZZY_REGION=false
