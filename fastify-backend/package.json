{
  "name": "geoloom-rag-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "GeoLoom-RAG 空间智能后端服务 (PostgreSQL + PostGIS + pgvector)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate:vectors": "node scripts/migrate_to_pgvector.js",
    "verify:vectors": "node scripts/verify_vectors.js",
    "import:pois": "node scripts/import_poi_data.js",
    "worker:spatial": "node workers/spatialWorker.js",
    "python:grpc": "python python_service/grpc_server.py",
    "python:http": "python python_service/app.py",
    "dev:stack": "node scripts/dev_stack.js",
    "smoke:jobs": "node scripts/smoke_jobs_flow.js",
    "bench:jobs": "node scripts/bench_jobs.js",
    "kpi:report": "node scripts/kpi_report.js --window=7d",
    "template:weights": "node scripts/recompute_template_weights.js --window_days=7",
    "ops:hotspots": "node scripts/select_hotspot_operators.js --window=7d",
    "sql:apply": "node scripts/apply_sql_script.js",
    "sql:apply:obs": "node scripts/apply_sql_script.js --file=sql/05_ai_observability.sql"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^5.61.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.0",
    "glob": "^13.0.0",
    "h3-js": "^4.4.0",
    "ioredis": "^5.8.1",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "jsonparse": "^1.3.1"
  }
}
